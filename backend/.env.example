# Porta da API
PORT=3333

# Troque por um valor longo e aleatório em produção
JWT_SECRET=troque-este-segredo

# Connection string do PostgreSQL no Neon (Painel do Neon > Connect)
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# Origem do frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Envio do código de redefinição de senha.
# Sem SMTP configurado, o código é exibido no terminal do backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DesospIdoso <nao-responda@desospidoso.com>"
